[Unit]
Description=RecoRouter Rust API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=recorouter
Group=recorouter
WorkingDirectory=/opt/recorouter/current
EnvironmentFile=/etc/recorouter/recorouter.env
ExecStart=/opt/recorouter/current/recorouter-api
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/recorouter /etc/recorouter

[Install]
WantedBy=multi-user.target
