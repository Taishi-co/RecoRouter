{
  "name": "coze-mini-program",
  "version": "1.0.24",
  "private": true,
  "description": "Coze Mini Program Application",
  "scripts": {
    "build": "pnpm exec concurrently --kill-others-on-fail --kill-signal SIGKILL -n lint,tsc,web,weapp,tt,server -c red,blue,green,yellow,cyan,magenta \"pnpm lint:build\" \"pnpm tsc\" \"pnpm build:web\" \"pnpm build:weapp\" \"pnpm build:tt\" \"pnpm build:server\"",
    "build:pack": "pnpm exec concurrently --kill-others-on-fail --kill-signal SIGKILL -n weapp,tt -c yellow,cyan \"pnpm build:weapp\" \"pnpm build:tt\"",
    "build:rust-server": "cargo build --manifest-path server/Cargo.toml --release --locked",
    "build:server": "cargo build --manifest-path server/Cargo.toml",
    "build:apis": "cargo build --manifest-path server/Cargo.toml --bins",
    "build:tt": "taro build --type tt",
    "build:weapp": "taro build --type weapp",
    "build:weapp:vehicle": "RECO_APP_PROFILE=vehicle taro build --type weapp",
    "build:weapp:mall": "RECO_APP_PROFILE=mall taro build --type weapp",
    "build:weapp:admin": "RECO_APP_PROFILE=admin taro build --type weapp",
    "build:web": "vite build --config web-admin/vite.config.ts",
    "build:web:vehicle": "RECO_APP_PROFILE=vehicle OUTPUT_ROOT=dist-web-vehicle taro build --type h5",
    "build:web:mall": "RECO_APP_PROFILE=mall OUTPUT_ROOT=dist-web-mall taro build --type h5",
    "build:web:admin": "RECO_APP_PROFILE=admin OUTPUT_ROOT=dist-web-admin taro build --type h5",
    "build:web:demo": "pnpm exec concurrently --kill-others-on-fail --kill-signal SIGKILL -n vehicle,mall -c blue,green \"pnpm build:web:vehicle\" \"pnpm build:web:mall\"",
    "check:admin-mall-auth": "node scripts/check-admin-mall-auth.mjs",
    "check:admin-mall-ops": "node scripts/check-admin-mall-ops.mjs",
    "check:merchant-enterprise-boundary": "node scripts/check-merchant-enterprise-boundary.mjs",
    "check:mall-cos-image-paths": "node scripts/check-mall-cos-image-paths.mjs",
    "check:mall-auth-profile": "node scripts/check-mall-auth-profile.mjs",
    "check:mall-real-checkout": "node scripts/check-mall-real-checkout.mjs",
    "check:mall-wechat-auth": "node scripts/check-mall-wechat-auth.mjs",
    "check:mall-h5-width": "node scripts/check-mall-h5-width.mjs",
    "check:mall-v7-customer-experience": "node scripts/check-mall-v7-customer-experience.mjs",
    "check:mall-delivery-only": "node scripts/check-mall-delivery-only.mjs",
    "check:mall-address-selection": "node scripts/check-mall-address-selection.mjs",
    "check:mall-cart-swipe-delete": "node scripts/check-mall-cart-swipe-delete.mjs",
    "check:mall-order-item-insert": "node scripts/check-mall-order-item-insert.mjs",
    "check:mall-profile-address-layout": "node scripts/check-mall-profile-address-layout.mjs",
    "check:mall-wallet-points-pages": "node scripts/check-mall-wallet-points-pages.mjs",
    "check:mall-delivery-range-rules": "node scripts/check-mall-delivery-range-rules.mjs",
    "check:mall-fixed-price-campaign": "node scripts/check-mall-fixed-price-campaign.mjs",
    "check:mall-promotion-venues": "node scripts/check-mall-promotion-venues.mjs",
    "check:mall-after-sales-workflow": "node scripts/check-mall-after-sales-workflow.mjs",
    "check:mall-procurement-qualifications": "node scripts/check-mall-procurement-qualifications.mjs",
    "check:mall-ops-dual-surface": "node scripts/check-mall-ops-dual-surface.mjs",
    "check:no-physical-fks": "node scripts/check-no-physical-foreign-keys.mjs",
    "check:no-deprecated-wechat-api": "node scripts/check-no-deprecated-wechat-api.mjs",
    "check:mall-product-refresh": "node scripts/check-mall-product-refresh.mjs",
    "check:network-query-sanitization": "node scripts/check-network-query-sanitization.mjs",
    "check:deploy-scripts": "bash -n deploy/*.sh",
    "check:miniapp-version": "node --test scripts/bump-miniapp-version.test.mjs",
    "check:registration-security": "node scripts/check-registration-security.mjs",
    "check:sqlx-migration-immutability": "node scripts/check-sqlx-migration-immutability.mjs",
    "check:web-admin-auth": "node scripts/check-web-admin-auth.mjs",
    "check:web-admin-mall-order-detail": "node scripts/check-web-admin-mall-order-detail.mjs",
    "check:web-admin-mall-pickup-leaders": "node scripts/check-web-admin-mall-pickup-leaders.mjs",
    "check:web-admin-mall-marketing": "node scripts/check-web-admin-mall-marketing.mjs",
    "check:web-admin-operations-dashboard": "node scripts/check-web-admin-operations-dashboard.mjs",
    "check:web-admin-mall-permissions": "node scripts/check-web-admin-mall-permissions.mjs",
    "check:web-admin-support-workbench": "node scripts/check-web-admin-support-workbench.mjs",
    "check:web-admin-human-copy": "node scripts/check-web-admin-human-copy.mjs",
    "check:web-admin-formal-shell": "node scripts/check-web-admin-formal-shell.mjs",
    "dev": "pnpm exec concurrently --kill-others --kill-signal SIGKILL -n web,server -c blue,green \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:server": "cargo run --manifest-path server/Cargo.toml",
    "dev:vehicle-api": "cargo run --manifest-path server/Cargo.toml --bin vehicle-api",
    "dev:mall-api": "cargo run --manifest-path server/Cargo.toml --bin mall-api",
    "dev:platform-api": "cargo run --manifest-path server/Cargo.toml --bin platform-api",
    "dev:tt": "taro build --type tt --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:weapp:vehicle": "RECO_APP_PROFILE=vehicle taro build --type weapp --watch",
    "dev:weapp:mall": "RECO_APP_PROFILE=mall taro build --type weapp --watch",
    "dev:weapp:admin": "RECO_APP_PROFILE=admin taro build --type weapp --watch",
    "dev:web": "vite --config web-admin/vite.config.ts --host 0.0.0.0",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "weapp-tw patch",
    "kill:all": "pkill -9 -f 'concurrently' 2>/dev/null || true; pkill -9 -f 'recorouter-api' 2>/dev/null || true; pkill -9 -f 'cargo run.*server/Cargo.toml' 2>/dev/null || true; pkill -9 -f 'taro build' 2>/dev/null || true; pkill -9 -f 'node.*dev' 2>/dev/null || true; echo 'All dev processes cleaned'",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "lint:build": "eslint \"src/**/*.{js,jsx,ts,tsx,css}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx,css}\" --fix",
    "loadtest:backend": "node scripts/loadtest-backend.mjs",
    "loadtest:backend:readiness": "node scripts/loadtest-backend-readiness.mjs",
    "migrate:server": "MIGRATION_SERVICE=legacy cargo run --manifest-path server/Cargo.toml --bin recorouter-migrator",
    "migrate:vehicle-api": "MIGRATION_SERVICE=vehicle cargo run --manifest-path server/Cargo.toml --bin recorouter-migrator",
    "migrate:mall-api": "MIGRATION_SERVICE=mall cargo run --manifest-path server/Cargo.toml --bin recorouter-migrator",
    "migrate:platform-api": "MIGRATION_SERVICE=platform cargo run --manifest-path server/Cargo.toml --bin recorouter-migrator",
    "new": "taro new",
    "preview:tt": "taro build --type tt --preview",
    "preview:weapp": "taro build --type weapp --preview",
    "test:rust-server": "cargo test --manifest-path server/Cargo.toml --lib --bins --tests",
    "test:rust-server:db": "test -n \"$TEST_DATABASE_URL\" && cargo test --manifest-path server/Cargo.toml --lib --bins --tests",
    "test:service-routers": "cargo test --manifest-path server/Cargo.toml --test service_routers",
    "tsc": "npx tsc --noEmit --skipLibCheck",
    "validate:split": "pnpm exec concurrently --kill-others-on-fail --kill-signal SIGKILL -n routers,apis,no-fks,boundary,deploy-sh -c blue,magenta,cyan,yellow,green \"pnpm test:service-routers\" \"pnpm build:apis\" \"pnpm check:no-physical-fks\" \"pnpm check:merchant-enterprise-boundary\" \"pnpm check:deploy-scripts\"",
    "validate": "pnpm exec concurrently --kill-others-on-fail --kill-signal SIGKILL -n lint,tsc,sqlx-migrations,miniapp-version,wechat-api,mall-refresh,network-query,web-auth,admin-mall,admin-ops,mall-cos,mall-auth,mall-real,mall-wechat,mall-width,mall-v7,mall-delivery,mall-address,mall-swipe,mall-order-items,mall-profile-layout,mall-wallet-points,mall-delivery-range,mall-fixed-price,mall-promotion-venues,mall-after-sales,mall-procurement,mall-ops-dual,web-order-detail,web-pickup-leaders,web-marketing,web-ops-data,web-permissions,web-support,web-human-copy,web-formal-shell -c red,blue,magenta,cyan,yellow,green,white,gray,redBright,blueBright,magentaBright,greenBright,cyanBright,yellowBright,whiteBright,blue,magenta,cyan,red,blueBright,green,cyanBright,redBright,yellow,greenBright,blue,magentaBright,whiteBright,blueBright,green,yellow,redBright \"pnpm lint:build\" \"pnpm tsc\" \"pnpm check:sqlx-migration-immutability\" \"pnpm check:miniapp-version\" \"pnpm check:no-deprecated-wechat-api\" \"pnpm check:mall-product-refresh\" \"pnpm check:network-query-sanitization\" \"pnpm check:web-admin-auth\" \"pnpm check:admin-mall-auth\" \"pnpm check:admin-mall-ops\" \"pnpm check:mall-cos-image-paths\" \"pnpm check:mall-auth-profile\" \"pnpm check:mall-real-checkout\" \"pnpm check:mall-wechat-auth\" \"pnpm check:mall-h5-width\" \"pnpm check:mall-v7-customer-experience\" \"pnpm check:mall-delivery-only\" \"pnpm check:mall-address-selection\" \"pnpm check:mall-cart-swipe-delete\" \"pnpm check:mall-order-item-insert\" \"pnpm check:mall-profile-address-layout\" \"pnpm check:mall-wallet-points-pages\" \"pnpm check:mall-delivery-range-rules\" \"pnpm check:mall-fixed-price-campaign\" \"pnpm check:mall-promotion-venues\" \"pnpm check:mall-after-sales-workflow\" \"pnpm check:mall-procurement-qualifications\" \"pnpm check:mall-ops-dual-surface\" \"pnpm check:web-admin-mall-order-detail\" \"pnpm check:web-admin-mall-pickup-leaders\" \"pnpm check:web-admin-mall-marketing\" \"pnpm check:web-admin-operations-dashboard\" \"pnpm check:web-admin-mall-permissions\" \"pnpm check:web-admin-support-workbench\" \"pnpm check:web-admin-human-copy\" \"pnpm check:web-admin-formal-shell\""
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,css}": [
      "eslint"
    ]
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.1.9",
    "@tarojs/helper": "4.1.9",
    "@tarojs/plugin-framework-react": "4.1.9",
    "@tarojs/plugin-platform-h5": "4.1.9",
    "@tarojs/plugin-platform-tt": "4.1.9",
    "@tarojs/plugin-platform-weapp": "4.1.9",
    "@tarojs/react": "4.1.9",
    "@tarojs/runtime": "4.1.9",
    "@tarojs/shared": "4.1.9",
    "@tarojs/taro": "4.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react-taro": "^1.4.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tarojs/cli": "4.1.9",
    "@tarojs/plugin-generator": "4.1.9",
    "@tarojs/plugin-mini-ci": "^4.1.9",
    "@tarojs/vite-runner": "4.1.9",
    "@types/minimatch": "^5",
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-preset-taro": "4.1.9",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.1.9",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "less": "^4.2.0",
    "lint-staged": "^16.1.2",
    "miniprogram-ci": "^2.1.26",
    "only-allow": "^1.2.2",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^4.1.18",
    "terser": "^5.30.4",
    "tt-ide-cli": "^0.1.31",
    "typescript": "^5.4.5",
    "vite": "^4.2.0",
    "weapp-tailwindcss": "^4.10.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@tarojs/plugin-mini-ci@4.1.9": "patches/@tarojs__plugin-mini-ci@4.1.9.patch"
    }
  },
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Less",
    "framework": "React"
  }
}
