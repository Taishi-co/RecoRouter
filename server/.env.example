DATABASE_URL=postgres://postgres:change-me@postgres:5432/recocar
SERVER_PORT=34532

# Optional service-specific database and port overrides.
# If unset, the service falls back to DATABASE_URL and SERVER_PORT for local compatibility.
VEHICLE_DATABASE_URL=postgres://postgres:change-me@postgres:5432/recocar_vehicle
MALL_DATABASE_URL=postgres://postgres:change-me@postgres:5432/recocar_mall
PLATFORM_DATABASE_URL=postgres://postgres:change-me@postgres:5432/recocar_platform
VEHICLE_API_PORT=34532
MALL_API_PORT=34533
PLATFORM_API_PORT=34534

# Migration execution policy.
# Legacy recorouter-api defaults to running embedded migrations.
# Split services default to not running migrations to avoid concurrent startup races.
RUN_MIGRATIONS=
VEHICLE_RUN_MIGRATIONS=
MALL_RUN_MIGRATIONS=
PLATFORM_RUN_MIGRATIONS=
MIGRATION_SERVICE=legacy

PUBLIC_BASE_URL=https://car.shcxyz.site
LOCAL_UPLOAD_DIR=/app/uploads
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# Service-to-service auth foundation. Phase 2 uses this as the shared secret for
# X-Service-* HMAC signing once callback delivery is enabled.
INTERNAL_SERVICE_SECRET=

WECHAT_PAY_APPID=
WECHAT_PAY_VEHICLE_APPID=
WECHAT_PAY_MALL_APPID=
WECHAT_MINIAPP_SECRET=
WECHAT_PAY_MCH_ID=1746295681
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://car.shcxyz.site/api/payments/wechat/notify
WECHAT_TRANSFER_NOTIFY_URL=https://car.shcxyz.site/api/platform/transfers/wechat/notify
